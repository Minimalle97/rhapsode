// prisma/schema.prisma
// Fas 8 + delar + vänner.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  username    String
  /// Handtaget som anvandaren skrev det, med versaler bevarade.
  handle      String?
  /// Samma handtag i gemener. Det ar HAR unikheten sitter.
  ///
  /// Skalet: "Casper" och "casper" far inte kunna vara tva olika konton.
  /// Med unikhet pa visningsformen hade nagon kunnat registrera en
  /// versalvariant av ett befintligt namn och passera som den personen.
  handleLower String?  @unique
  /// Nagra rader om sig sjalv, synligt for vanner. Ren text.
  bio         String?
  avatarUrl   String?
  xp          Int      @default(0)
  rank        String   @default("The Uninitiated")
  streakDays  Int      @default(0)
  lastActive  DateTime @default(now())
  createdAt   DateTime @default(now())

  // ── Prenumeration ────────────────────────────────────────────────
  // Sanningen om vad någon får göra bor HÄR, på servern. Klienten får
  // läsa den men aldrig sätta den.
  plan                 String    @default("free") // free | pro
  planSource           String    @default("none") // none | stripe | grant | developer
  subscriptionStatus   String    @default("free") // free | trialing | active | past_due | cancelled | incomplete
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  works       Work[]
  medals      Medal[]
  dailyGoals  DailyGoal[]
  collections Collection[]

  aiUsage       AiUsage[]
  grants        AccessGrant[]
  events        AnalyticsEvent[]
  performances  Performance[]
  studySessions StudySession[]

  sentRequests     Friendship[] @relation("requester")
  receivedRequests Friendship[] @relation("addressee")
  posts            Post[]
  postLikes        PostLike[]

  /// Vilken gruppbard som bars just nu, som gruppens slug. Null = ingen.
  ///
  /// Att BARA en bard kraver Pro; att FORTJANA den gor det inte. Falten ar
  /// darfor skilda: GroupAward ar bedriften och overlever att en
  /// prenumeration tar slut, det har ar bara vad som ritas runt bilden.
  /// Slutar nagon betala slocknar barden, men bedriften star kvar.
  profileBorder String?

  groupAwards GroupAward[]

  duelsSent   Duel[]        @relation("duelChallenger")
  duelsFaced  Duel[]        @relation("duelOpponent")
  duelsWon    Duel[]        @relation("duelWinner")
  DuelAttempt DuelAttempt[]
}

// Vänskap: en rad per relation, oavsett riktning.
// status är "pending" eller "accepted"
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Work {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  author           String
  type             String
  tags             String[]
  analysis         String?
  practiceAdvice   String?
  difficulty       String   @default("medium")
  estimatedMinutes Int      @default(15)
  createdAt        DateTime @default(now())

  /// private | public. Standard ar private, och det ar ett val: en text
  /// nagon ovar pa kan vara ett tal till en begravning. Den som vill visa
  /// vad de arbetar med far saga till, inte tvartom.
  visibility String @default("private")

  /// Loptnumret i repertoaren (1-762), nar verket lades till DARIFRAN.
  ///
  /// Satt bara pa den vagen, och da ar kopplingen exakt. Verk som redan
  /// lag i biblioteket kanns i stallet igen pa titel och upphovsperson —
  /// se lib/repertoire.ts. Stampeln vinner nar bada finns, for den ar ett
  /// val nagon gjort och inte en gissning.
  canonicalId Int?

  parts        Part[]
  sections     Section[]
  medals       Medal[]
  collections  CollectionWork[]
  performances Performance[]
  posts        Post[]

  duelsAsChallenger Duel[]        @relation("duelChallengerWork")
  duelsAsOpponent   Duel[]        @relation("duelOpponentWork")
  duelAttempts      DuelAttempt[] @relation("duelAttemptWork")

  @@index([userId])
}

// Delar: sånger, böcker, akter, scener
model Part {
  id         String   @id @default(cuid())
  workId     String
  work       Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  sections Section[]

  @@index([workId, orderIndex])
}

model Section {
  id     String  @id @default(cuid())
  workId String
  work   Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  partId String?
  part   Part?   @relation(fields: [partId], references: [id], onDelete: Cascade)

  name       String
  content    String
  difficulty String @default("medium")
  status     String @default("not_started")
  orderIndex Int    @default(0)

  sm2Reps     Int       @default(0)
  sm2EF       Float     @default(2.5)
  sm2Interval Int       @default(1)
  nextReview  DateTime?

  createdAt DateTime @default(now())

  practiceSessions PracticeSession[]

  @@index([workId, orderIndex])
  @@index([partId, orderIndex])
  @@index([nextReview])
}

model PracticeSession {
  id           String   @id @default(cuid())
  sectionId    String
  section      Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quality      Int
  score        Int?
  mode         String
  xpEarned     Int      @default(0)
  durationSecs Int      @default(0)
  createdAt    DateTime @default(now())

  // Behålls för att mästerskapsalgoritmen ska kunna förbättras i
  // efterhand utan att gammal historik blir värdelös. Allt här räknas
  // fram deterministiskt — ingen modell är inblandad.
  cueLevel     String? // full | firstWord | initials | skeleton | hidden
  wordsTotal   Int?
  wordsCorrect Int?
  missedWords  String[]
  gradedBy     String   @default("deterministic") // deterministic | assisted

  @@index([sectionId])
  @@index([createdAt])
}

model Medal {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId   String
  work     Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  title    String
  earnedAt DateTime @default(now())

  /// work        — alla sektioner bemastrade enligt SM-2. Guld. Behalls.
  /// performance — tio godkanda framforanden. Rod. Kan forloras.
  /// battle      — vunnen tvekamp. Gron. Behalls, och kan inte forloras:
  ///               den star for en dag som redan ar over.
  kind   String  @default("work")
  /// Satt for langa verk dar framforandet galler en del i taget.
  partId String?

  /// Satt for battle-medaljer. Gor utdelningen idempotent — en tvekamp
  /// kan avgoras av vem som helst som rakar ladda sidan efter sluttiden,
  /// och tva samtidiga laddningar far inte ge tva medaljer.
  duelId String?

  /// Nar mastartiteln foll. Medaljen raderas inte — den slocknar, och
  /// tands igen nasta gang kravet ar uppfyllt. Att radera historik for
  /// att nagon missat tre dagar vore att stryka nagot de faktiskt gjort.
  lostAt DateTime?

  @@unique([userId, duelId])
  @@index([userId])
  @@index([userId, kind])
  @@index([workId, kind])
}

model DailyGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  targetSecs    Int      @default(600)
  completedSecs Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
}

model Collection {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  works CollectionWork[]

  @@index([userId])
}

model CollectionWork {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  workId       String
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, workId])
}

// ─────────────────────────────────────────────────────────────────────
// MONETISERING
//
// Allt nedan är additivt. Ingen befintlig kolumn har bytt namn eller
// typ, och ingenting raderas — befintliga verk, sektioner och historik
// är orörda.
// ─────────────────────────────────────────────────────────────────────

/// Huvudboken över modellanrop. En rad per anrop, även träffar i cachen
/// och blockerade försök — annars går det inte att svara på frågan
/// "vad kostade förra månaden, och på vad".
model AiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  feature String // se lib/ai/features.ts
  model   String

  inputTokens         Int @default(0)
  outputTokens        Int @default(0)
  cachedInputTokens   Int @default(0)
  /// Mikrodollar (1_000_000 = 1 USD). Heltal — flyttal driver iväg när
  /// man summerar hundratusen rader.
  estimatedCostMicros Int @default(0)

  requestId String?
  cached    Boolean  @default(false)
  status    String   @default("ok") // ok | error | blocked
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
}

/// Atomär räknare för både månadskvot och hastighetsbegränsning.
/// Poängen är unique([scope, key, windowStart]): ökningen sker i ETT
/// statement med ett villkor, så tio samtidiga anrop kan inte alla läsa
/// "4 av 5 använda" och sedan alla skriva 5.
model UsageCounter {
  id          String   @id @default(cuid())
  scope       String // ai_month | ai_burst | http_burst
  key         String // userId, eller ip för utloggade
  windowStart DateTime
  used        Int      @default(0)
  expiresAt   DateTime
  updatedAt   DateTime @updatedAt

  @@unique([scope, key, windowStart])
  @@index([expiresAt])
}

/// Delad cache för modellsvar.
///
/// Två personer som laddar upp samma upphovsrättsfria text och ber om
/// samma sak ska inte kosta två anrop. Nyckeln räknas fram ur innehållet,
/// inte ur användaren — därför kan raden delas. Personliga svar (t.ex.
/// en studieplan byggd på din egen historik) får shared = false och en
/// nyckel som innehåller userId.
model AiCache {
  id       String @id @default(cuid())
  cacheKey String @unique

  feature String
  model   String
  payload Json

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  shared    Boolean   @default(true)
  hits      Int       @default(0)
  createdAt DateTime  @default(now())
  lastUsed  DateTime  @default(now())
  expiresAt DateTime?

  @@index([feature])
  @@index([expiresAt])
}

/// En inlösbar kod som ger Pro utan betalning. Skapas från kommandoraden
/// (scripts/access-code.mjs), aldrig från gränssnittet.
model AccessCode {
  id   String @id @default(cuid())
  code String @unique

  plan           String    @default("pro")
  /// null = gäller tills den återkallas
  durationDays   Int?
  maxRedemptions Int       @default(1)
  redemptions    Int       @default(0)
  note           String?
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  grants AccessGrant[]

  @@index([active])
}

/// Resultatet av en inlöst kod, eller en manuellt utdelad behörighet.
model AccessGrant {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeId String?
  code   AccessCode? @relation(fields: [codeId], references: [id], onDelete: SetNull)

  plan      String    @default("pro")
  source    String    @default("code") // code | manual
  note      String?
  startsAt  DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeId])
  @@index([userId, expiresAt])
}

/// Stripe skickar om webhooks vid minsta osäkerhet. Utan den här tabellen
/// skulle ett omskickat event kunna räknas två gånger.
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())

  @@index([type, receivedAt])
}

/// Intern händelselogg. Inga personuppgifter — userId och ett namn.
model AnalyticsEvent {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  name      String
  props     Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

/// Performance Mode. Tabellen finns redan nu så att framtida framföranden
/// kan skrivas ned utan en ny migration mitt i en release.
model Performance {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  work   Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  partId String?

  accuracy       Int // 0-100
  hesitations    Int  @default(0)
  missedSections Int  @default(0)
  rhythmScore    Int?
  longestPauseMs Int?
  consistency    Int?
  durationSecs   Int  @default(0)

  /// Rakhades korningen mot de tio som kravs for mastartiteln?
  /// Under trosceln sparas den anda — man ska kunna se sin kurva, inte
  /// bara sina segrar.
  passed Boolean @default(false)
  isBest Boolean @default(false)
  detail Json?

  createdAt DateTime @default(now())

  @@index([userId, workId, createdAt])
  @@index([workId, isBest])
}

/// Study Mode. Planen sparas som JSON så att formen på ett studiepass kan
/// utvecklas utan att schemat behöver ändras varje gång.
model StudySession {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId String
  partId String?

  goal       String // memorise | understand | perform | language
  language   String?
  difficulty String   @default("normal") // gentle | normal | demanding
  tools      String[]
  minutes    Int      @default(15)

  plan        Json?
  status      String    @default("draft") // draft | active | completed | abandoned
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([workId])
}

// ─────────────────────────────────────────────────────────────────────
// VANNER: inlagg och gillningar
// ─────────────────────────────────────────────────────────────────────

/// Ett inlagg pa nagons profil.
///
/// Tva sorter, med flit atskilda:
///
///   milestone — appen skriver det sjalv nar nagot hant ("bemastrade
///               Invictus"). Verket lankas, och DA maste det vara
///               publikt for att namnges.
///   note      — nagot man skrivit sjalv.
///
/// Skillnaden spelar roll for vad som gar att lita pa: en milstolpe ar
/// bevisad av appen, en anteckning ar bara ett pastaende.
model Post {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind String @default("note") // note | milestone
  body String

  /// Satt for milstolpar. Verket namnges bara om det ar publikt.
  ///
  /// SetNull, inte Cascade: raderar man verket ska minnet av att man en
  /// gang kunde det inte forsvinna ur floden dar vanner redan sett det.
  workId String?
  work   Work?   @relation(fields: [workId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  likes PostLike[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// En gillning. Unik per person och inlagg — man gillar en gang.
model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────
// TVEKAMP
//
// Tva personer, en text, en klocka. Den som haller flest ord nar tiden
// gar ut vinner en medalj; bada behaller verket.
//
// Tre saker ar avsiktliga i formen nedan.
//
// Var och en far sin EGEN kopia av verket. Ett delat verk hade betytt
// delade sektioner, delad SM-2-historik och delade framsteg, och da finns
// det inget att mata. Kopian ar ett riktigt verk i mottagarens bibliotek,
// med samma verktyg som originalet — inte en lasvy.
//
// Verk-id:na ar valfria och SetNull. Raderar nagon sitt verk efteråt ska
// resultatet sta kvar; det ar en handelse som intraffat, inte ett verk.
// Darfor ligger titel och forfattare ocksa frysta pa raden.
//
// `result` ar fryst statistik, inte en vy. Rakningen sker en gang, nar
// klockan gar ut, och sparas. Skulle matningen skarpas senare ska en
// avgjord tvekamp inte kunna byta vinnare i efterhand.
model Duel {
  id String @id @default(cuid())

  /// Den som bjod in. Alltid Pro — se lib/duels.ts.
  challengerId String
  challenger   User   @relation("duelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  opponentId   String
  opponent     User   @relation("duelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)

  /// Utmanarens egen kopia — verket de delade.
  challengerWorkId String?
  challengerWork   Work?   @relation("duelChallengerWork", fields: [challengerWorkId], references: [id], onDelete: SetNull)
  /// Motstandarens kopia. Skapas forst nar inbjudan antas.
  opponentWorkId   String?
  opponentWork     Work?   @relation("duelOpponentWork", fields: [opponentWorkId], references: [id], onDelete: SetNull)

  /// Frysta vid inbjudan, sa att resultatet gar att lasa aven efter att
  /// bada raderat sina kopior.
  workTitle  String
  workAuthor String

  /// 10 | 60 | 180 | 1440 | 10080. Se DURATIONS i lib/duels.ts.
  durationMinutes Int

  /// pending | active | finished | declined | cancelled
  status String @default("pending")

  createdAt DateTime  @default(now())
  /// Klockan startar nar inbjudan ANTAS, inte nar den skickas. Annars
  /// hade utmanaren kunnat bjuda in och ova en timme innan svaret kom.
  startedAt DateTime?
  endsAt    DateTime?
  settledAt DateTime?

  /// Nar utmanaren sett att inbjudan antagits.
  ///
  /// Finns bara for den grona bubblan pa Friends-fliken. Utan ett falt
  /// som gar att kvittera skulle bubblan lysa hela kampen igenom, och en
  /// notis som aldrig slocknar ar ingen notis — den ar en dekoration man
  /// slutar se efter en dag.
  acceptedSeenAt DateTime?

  /// null efter avgorande = oavgjort. Bada halls lika manga ord.
  winnerId String?
  winner   User?   @relation("duelWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  result Json?

  attempts DuelAttempt[]

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([status, endsAt])
  @@index([challengerWorkId])
  @@index([opponentWorkId])
}

/// Ett framforande som raknas FOR TVEKAMPEN och for ingenting annat.
///
/// Egen tabell, inte en flagga pa Performance. Skalet ar att Performance
/// bar mastartiteln: en rad dar drar XP, flyttar standing, tander eller
/// slacker medaljer och kan skriva en milstolpe i vannernas flode. Ett
/// tvekampsforsok ska gora inget av det. Med en flagga hade varje
/// befintlig fraga behovt komma ihag att filtrera bort den, och den dagen
/// nagon glommer det borjar en tvekamp dela ut mastartitlar.
///
/// SM-2 ror det inte heller. Ovningen som ger procenten i biblioteket och
/// kampen som avgors pa klockan ar tva skilda saker, och det var sa det
/// bestalldes: ingen traning allokeras till tvekampens siffra, och
/// tvekampen flyttar inte inlarningskurvan.
model DuelAttempt {
  id     String @id @default(cuid())
  duelId String
  duel   Duel   @relation(fields: [duelId], references: [id], onDelete: Cascade)

  /// Vem som gjorde forsoket. Bada sidor skriver till samma tabell.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Den egna kopian forsoket gallde. SetNull — resultatet overlever att
  /// verket raderas.
  workId String?
  work   Work?   @relation("duelAttemptWork", fields: [workId], references: [id], onDelete: SetNull)

  /// 0-100, ur samma Levenshtein-jamforelse som allt annat i appen.
  accuracy       Int
  wordsTotal     Int      @default(0)
  wordsCorrect   Int      @default(0)
  durationSecs   Int      @default(0)
  hesitations    Int      @default(0)
  longestPauseMs Int?
  missedWords    String[]

  createdAt DateTime @default(now())

  @@index([duelId, userId, wordsCorrect])
  @@index([duelId, createdAt])
}

/// En avklarad grupp ur repertoaren.
///
/// Grupperna sjalva ligger inte i databasen — de ar 24 rader statisk
/// referensdata i lib/repertoire/data.ts och byter aldrig innehall per
/// anvandare. Har star bara DET SOM HANT: att nagon tagit hela gruppen,
/// och om de last upp barden.
///
/// Tva tidpunkter, med flit atskilda:
///
///   earnedAt   — gruppen blev klar. Delas ut automatiskt vid avstamning
///                och kraver ingen plan. Bedriften ar allas.
///   unlockedAt — lasset klickades och barden togs i bruk. Kraver Pro.
///
/// Att de ar skilda ar hela poangen. En gratisanvandare som tar
/// Shakespeare ska se att de gjort det, och se exakt vad som ligger
/// bakom lasset. Den dagen de betalar finns bedriften redan dar och
/// vantar — den behover inte goras om.
model GroupAward {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Gruppens slug, t.ex. "the-romantics". Se lib/repertoire/data.ts.
  groupId String

  earnedAt   DateTime  @default(now())
  unlockedAt DateTime?

  @@unique([userId, groupId])
  @@index([userId])
}
