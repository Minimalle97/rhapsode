// prisma/schema.prisma
// Fas 8 + delar + vänner.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  clerkId    String   @unique
  username   String
  handle     String?  @unique
  avatarUrl  String?
  xp         Int      @default(0)
  rank       String   @default("The Uninitiated")
  streakDays Int      @default(0)
  lastActive DateTime @default(now())
  createdAt  DateTime @default(now())

  works       Work[]
  medals      Medal[]
  dailyGoals  DailyGoal[]
  collections Collection[]

  sentRequests     Friendship[] @relation("requester")
  receivedRequests Friendship[] @relation("addressee")
}

// Vänskap: en rad per relation, oavsett riktning.
// status är "pending" eller "accepted"
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("requester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("addressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model Work {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  author           String
  type             String
  tags             String[]
  analysis         String?
  practiceAdvice   String?
  difficulty       String   @default("medium")
  estimatedMinutes Int      @default(15)
  createdAt        DateTime @default(now())

  parts       Part[]
  sections    Section[]
  medals      Medal[]
  collections CollectionWork[]

  @@index([userId])
}

// Delar: sånger, böcker, akter, scener
model Part {
  id         String   @id @default(cuid())
  workId     String
  work       Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  name       String
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  sections Section[]

  @@index([workId, orderIndex])
}

model Section {
  id         String  @id @default(cuid())
  workId     String
  work       Work    @relation(fields: [workId], references: [id], onDelete: Cascade)
  partId     String?
  part       Part?   @relation(fields: [partId], references: [id], onDelete: Cascade)

  name       String
  content    String
  difficulty String  @default("medium")
  status     String  @default("not_started")
  orderIndex Int     @default(0)

  sm2Reps     Int       @default(0)
  sm2EF       Float     @default(2.5)
  sm2Interval Int       @default(1)
  nextReview  DateTime?

  createdAt DateTime @default(now())

  practiceSessions PracticeSession[]

  @@index([workId, orderIndex])
  @@index([partId, orderIndex])
  @@index([nextReview])
}

model PracticeSession {
  id            String   @id @default(cuid())
  sectionId     String
  section       Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  quality       Int
  score         Int?
  mode          String
  xpEarned      Int      @default(0)
  durationSecs  Int      @default(0)
  recordingPath String?
  createdAt     DateTime @default(now())

  @@index([sectionId])
  @@index([createdAt])
}

model Medal {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workId   String
  work     Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
  title    String
  earnedAt DateTime @default(now())

  @@index([userId])
}

model DailyGoal {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime
  targetSecs    Int      @default(600)
  completedSecs Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, date])
}

model Collection {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  color      String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  works CollectionWork[]

  @@index([userId])
}

model CollectionWork {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  workId       String
  work         Work       @relation(fields: [workId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())

  @@unique([collectionId, workId])
}