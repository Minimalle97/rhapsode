# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/library
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/library

# Supabase — https://supabase.com → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Prisma — anslut till Supabase PostgreSQL
# Settings → Database → Connection string (URI), välj "Transaction pooler"
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase service role — server-side only, aldrig NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Claude ───────────────────────────────────────────────────────────
# Server-side only. Det får ALDRIG finnas en NEXT_PUBLIC_-variant av den
# här; allt som börjar med NEXT_PUBLIC_ bakas in i klientpaketet.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Modell per uppgiftstyp. Utelämnas de används standardvärdena i
# lib/ai/models.ts (opus-5 / sonnet-5 / haiku-4-5).
# AI_MODEL_REASONING=claude-opus-5
# AI_MODEL_STANDARD=claude-sonnet-5
# AI_MODEL_LIGHT=claude-haiku-4-5

# Tak för hela installationens modellkostnad per månad, i USD. Gäller de
# anrop som inte dras från någon användares kvot (katalogisering vid
# import, medaljtitlar). Standard 200.
AI_GLOBAL_MONTHLY_BUDGET_USD=200

# ── Gränser ──────────────────────────────────────────────────────────
# Alla valfria. Standardvärdena står i lib/billing/plans.ts.
FREE_AI_MONTHLY_LIMIT=5
PRO_AI_MONTHLY_LIMIT=100
FREE_SAVED_WORKS_LIMIT=3
# FREE_AI_BURST_PER_MINUTE=3
# PRO_AI_BURST_PER_MINUTE=10

# ── Stripe ───────────────────────────────────────────────────────────
# Server-side only. Lägg dem i Vercels projektinställningar som
# "sensitive" — då är värdet skrivbart men aldrig läsbart igen, varken i
# loggar eller i gränssnittet.
#
# ANVÄND EN RESTRICTED KEY (rk_), inte en secret key (sk_). En sk_ kan
# göra allt i kontot; en rk_ kan bara det du kryssat i. Den här
# integrationen behöver exakt fyra behörigheter:
#
#   Customers                write
#   Checkout Sessions        write
#   Billing Portal Sessions  write
#   Subscriptions            read
#
# Inget annat. Skapas under Developers → API keys → Create restricted key.
# Blir nyckeln stulen kan den inte flytta pengar, inte läsa hela
# kundregistret och inte skapa nya nycklar.
#
# scripts/stripe-setup.mjs behöver dessutom Products och Prices write —
# kör det med en separat nyckel, en gång, lokalt.
STRIPE_SECRET_KEY=rk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# price_… från Stripe → Products → Rhapsode Pro. Priset i lib/billing/plans.ts
# är det som VISAS; det som DRAS bestäms av prisobjektet i Stripe. Håll ihop dem.
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxxxxxxxxxxxxxxxx

# Priset, i ören. 7900 = 79,00 kr. Läses av BÅDE appen (för det som
# visas) och scripts/stripe-setup.mjs (för det som skapas i Stripe), så
# de två kan inte glida isär.
PRO_PRICE_MONTHLY_MINOR=7900
PRO_PRICE_YEARLY_MINOR=69900
BILLING_CURRENCY=sek

# Momsberäkning. LÄMNA AVSTÄNGD tills registreringen finns.
#
# Sätter man den till true utan en aktiv registrering under Stripe → Tax
# räknar Stripe fram noll moms och tar inte in någonting — utan att
# klaga. Integrationen ser korrekt ut medan momsskulden växer. Det är den
# vanligaste och dyraste missen med Stripe Tax.
#
# Rhapsode säljer till konsumenter i EU och kommer att behöva det här.
# Ordningen är: registrera först, slå på sedan.
# https://docs.stripe.com/billing/taxes/collect-taxes.md
STRIPE_AUTOMATIC_TAX=false

# Absolut URL till appen. Används för Stripes success- och return-adresser.
NEXT_PUBLIC_APP_URL=https://rhapsode.site

# ── Utvecklaråtkomst ─────────────────────────────────────────────────
# Kommaseparerade användar-id (vårt eget eller Clerks). De här kontona har
# alltid Pro, utan betalning och utan rad i databasen. Hämta ditt id med:
#
#   npm run codes whoami
#
# Till andra: dela ut inlösbara koder i stället, med `npm run codes new`.
RHAPSODE_DEVELOPER_USER_IDS=

# ── Test ─────────────────────────────────────────────────────────────
# Sätts bara när integrationstesterna ska köras mot en riktig databas.
# Peka den ALDRIG på produktionsdatabasen — testerna skriver.
# TEST_DATABASE_URL=postgresql://localhost:5432/rhapsode_test
